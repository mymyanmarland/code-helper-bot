# ═══════════════════════════════════════════════════════════════════════════
# Git Configuration
# GitHub Codespaces Ready
# ═══════════════════════════════════════════════════════════════════════════

[user]
    # Update these with your details
    name = Your Name
    email = your.email@example.com

[init]
    defaultBranch = main

[core]
    editor = code --wait
    autocrlf = input
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    pager = less -F -X
    excludesfile = ~/.gitignore_global

[color]
    ui = auto
    status = auto
    branch = auto
    diff = auto

[color "branch"]
    current = cyan bold
    local = cyan
    remote = magenta

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
    whitespace = red reverse

[color "status"]
    added = green bold
    changed = yellow bold
    untracked = red bold

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true
    followTags = true

[fetch]
    prune = true
    pruneTags = true

[merge]
    conflictstyle = diff3
    tool = code

[diff]
    colorMoved = zebra
    tool = code

[difftool "code"]
    cmd = code --wait --diff $LOCAL $REMOTE

[mergetool "code"]
    cmd = code --wait $MERGED

[rebase]
    autoStash = true
    autoSquash = true

[rerere]
    enabled = true

[help]
    autocorrect = 10

[credential]
    helper = cache --timeout=3600

# ─────────────────────────────────────────────────────────────────────────────
# ALIASES
# ─────────────────────────────────────────────────────────────────────────────
[alias]
    # Basic shortcuts
    s = status -sb
    co = checkout
    cob = checkout -b
    br = branch
    ci = commit
    cm = commit -m
    ca = commit --amend
    can = commit --amend --no-edit
    
    # Add shortcuts
    a = add
    aa = add --all
    ap = add --patch
    
    # Push/Pull
    p = push
    pf = push --force-with-lease
    pl = pull
    plr = pull --rebase
    
    # Stash
    st = stash
    stp = stash pop
    stl = stash list
    std = stash drop
    
    # Diff
    d = diff
    ds = diff --staged
    dc = diff --cached
    
    # Log variants
    l = log --oneline -15
    lg = log --oneline --graph --decorate
    lga = log --oneline --graph --decorate --all
    ll = log --pretty=format:'%C(cyan)%h%Creset %C(yellow)%d%Creset %s %C(dim)(%cr by %an)%Creset' --abbrev-commit
    hist = log --pretty=format:'%C(cyan)%h%Creset %C(yellow)%ad%Creset | %s%C(auto)%d%Creset %C(dim)[%an]%Creset' --graph --date=short
    today = log --since=midnight --oneline --author='$(git config user.email)'
    week = log --since='1 week ago' --oneline --author='$(git config user.email)'
    
    # Branch management
    branches = branch -a
    remotes = remote -v
    tags = tag -l
    
    # Cleanup
    cleanup = !git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d
    
    # Undo shortcuts
    undo = reset --soft HEAD~1
    unstage = reset HEAD --
    discard = checkout --
    
    # Show files
    files = diff --name-only
    changed = diff --name-status
    
    # Contributors
    contributors = shortlog -sn --no-merges
    
    # Find
    find = !git ls-files | grep -i
    grep = grep -Ii
    
    # Aliases list
    aliases = config --get-regexp alias
    
    # Quick save (WIP commit)
    save = !git add -A && git commit -m 'SAVEPOINT'
    wip = !git add -A && git commit -m 'WIP'
    unwip = reset HEAD~1
    
    # Initial commit
    init-commit = !git add -A && git commit -m 'Initial commit'
    
    # Sync with remote
    sync = !git fetch --all --prune && git rebase origin/$(git branch --show-current)
    
    # Interactive rebase for last n commits
    ri = "!f() { git rebase -i HEAD~$1; }; f"
    
    # Cherry pick
    cp = cherry-pick
    cpc = cherry-pick --continue
    cpa = cherry-pick --abort
    
    # Blame with better format
    praise = blame
    
    # Show last commit
    last = log -1 HEAD --stat
    
    # Quick amend without editing message
    oops = commit --amend --no-edit
    
    # Reset to origin
    reset-origin = !git fetch origin && git reset --hard origin/$(git branch --show-current)

# ─────────────────────────────────────────────────────────────────────────────
# URL SHORTCUTS
# ─────────────────────────────────────────────────────────────────────────────
[url "git@github.com:"]
    insteadOf = gh:
    pushInsteadOf = gh:

[url "git@gitlab.com:"]
    insteadOf = gl:
    pushInsteadOf = gl:

[url "git@bitbucket.org:"]
    insteadOf = bb:
    pushInsteadOf = bb:
