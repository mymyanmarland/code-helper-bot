# ═══════════════════════════════════════════════════════════════════════════
# Secrets Configuration (Template)
# Copy this to ~/.bash_secrets and fill in your API keys
# DO NOT commit this file to git!
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# AI API KEYS
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic (Claude)
export ANTHROPIC_API_KEY='your-anthropic-api-key'

# OpenAI (GPT, Codex)
export OPENAI_API_KEY='your-openai-api-key'

# Google AI (Gemini)
export GOOGLE_API_KEY='your-google-api-key'

# Mistral AI
export MISTRAL_API_KEY='your-mistral-api-key'

# Groq
export GROQ_API_KEY='your-groq-api-key'

# Together AI
export TOGETHER_API_KEY='your-together-api-key'

# ─────────────────────────────────────────────────────────────────────────────
# OTHER SECRETS
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Token (if not using gh auth)
# export GITHUB_TOKEN='your-github-token'

# ─────────────────────────────────────────────────────────────────────────────
# NOTES
# ─────────────────────────────────────────────────────────────────────────────
# 
# For GitHub Codespaces:
# - Use Codespaces Secrets in repository settings
# - Settings → Secrets and variables → Codespaces
# - Add your API keys there for automatic injection
#
# For local development:
# - Keep this file at ~/.bash_secrets
# - Make sure it's in your .gitignore
# - Source it in your .bashrc
#
